FROM public.ecr.aws/d3j8x8q7/olympus-base-typescript:latest

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip3 install --no-cache-dir uv==0.1.45 --break-system-packages || pip3 install --no-cache-dir uv==0.1.45

COPY . .

RUN uv pip install --system -e ".[dev]" || uv pip install --break-system-packages -e ".[dev]"
RUN npm ci && npm config set offline true

CMD ["/bin/bash"]

