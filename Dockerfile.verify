FROM public.ecr.aws/d3j8x8q7/olympus-base:latest

WORKDIR /app
COPY . .

# Synchronize Python dependencies from uv.lock into a virtual environment
RUN uv sync --frozen

# Install Node dependencies using clean install from package-lock.json
RUN npm ci --include=dev

ENV PATH="/app/.venv/bin:/app/node_modules/.bin:${PATH}"

CMD ["/bin/bash"]
